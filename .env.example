# AIGen Hub environment variables: NAMES ONLY. Values go into Vercel → Project → Settings → Environment Variables.
# Never put real values in this file or anywhere under D:\.

# supabase (production) | local (this PC only, test accounts; refused on Vercel)
AUTH_MODE=supabase

# Postgres connection used by the server (Supabase: the pooler string, port 6543, transaction mode)
DATABASE_URL=

# Public URL of the app (used in invitation links and sign-in redirects)
APP_URL=https://app.aigen.my

# Supabase project (Settings → API). The publishable key is designed to be public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service email (invitations). Optional until Resend is set up; without it the app shows a link to copy.
RESEND_API_KEY=
MAIL_FROM=AIGen Hub <hello@mail.aigen.my>

# on = show "Continue with Google" (after the Google OAuth client is added in Supabase)
GOOGLE_SIGN_IN=off
